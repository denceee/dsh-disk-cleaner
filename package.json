{
  "name": "@dencee/dsh-disk-cleaner",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness sidebar disk cleaner: the model ranks what occupies your drives, you tick and clean. Browsers and toolchains are discovered by structure, not by a hard-coded list.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "disk-cleaner",
    "disk-cleanup",
    "windows",
    "deepseek-harness"
  ],
  "license": "MIT",
  "author": {
    "name": "denceee",
    "url": "https://github.com/denceee"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denceee/dsh-disk-cleaner.git"
  },
  "homepage": "https://github.com/denceee/dsh-disk-cleaner#readme",
  "bugs": {
    "url": "https://github.com/denceee/dsh-disk-cleaner/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
