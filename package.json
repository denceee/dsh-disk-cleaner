{
  "name": "dsh-disk-cleaner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "磁盘清理 —— 侧边栏入口：AI 分析 C/D 盘空间占用，勾选清理项一键释放空间",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
